# ==========================================
# Frontend Environment Variables
# ==========================================

# Backend URL for Next.js server-side proxy rewrites (next.config.mjs)
# Set this on Vercel to your Render backend URL.
# The browser never sees this — all /api/* calls are proxied server-side, avoiding CORS.
NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com

# Alternative name (either one works, BACKEND_URL takes priority in next.config.mjs)
# BACKEND_URL=https://your-backend-app.onrender.com
